{
  "name": "releaseray",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that writes persona-specific release notes from merged pull requests and issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.20.0",
  "volta": {
    "node": "24.22.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "tsx scripts/check-deps.ts",
    "check:boundary": "tsx scripts/check-boundary.ts",
    "check:carried": "tsx scripts/check-carried.ts",
    "schema": "tsx scripts/generate-schema.ts",
    "check:schema": "tsx scripts/generate-schema.ts --check",
    "prompts": "tsx scripts/generate-prompts.ts",
    "check:prompts": "tsx scripts/generate-prompts.ts --check",
    "build": "tsx scripts/build.ts",
    "test:injection": "vitest run test/injection"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@aws-sdk/client-bedrock-runtime": "3.1169.0",
    "@octokit/rest": "22.0.1",
    "openai": "7.57.0",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
